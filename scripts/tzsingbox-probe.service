[Unit]
Description=tzsingbox isolated outbound verification client
After=network-online.target
[Service]
StateDirectory=tzsingbox-inventory
StateDirectoryMode=0755
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/tzsingbox/path-probe.py
Restart=on-failure
RestartSec=30
KillMode=control-group
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
MemoryMax=128M
TasksMax=32
UMask=0077
[Install]
WantedBy=multi-user.target
